<header class="site-header">
  <div class="announcement-bar">{{ section.settings.announcement | escape }}</div>
  <div class="header-inner">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      <img
        src="{{ section.settings.logo | default: 'mineral-mist-logo-light.jpg' | asset_url }}"
        alt=""
        width="52"
        height="52"
      >
      <span>{{ section.settings.brand_name | default: shop.name | escape }}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="{{ routes.root_url }}#products">Shop</a>
      <a href="{{ routes.root_url }}#story">Our Story</a>
      <a href="{{ routes.root_url }}#why-magnesium">Why Magnesium</a>
      <a href="{{ routes.root_url }}#faq">FAQ</a>
      <a href="{{ routes.root_url }}#contact">Contact</a>
    </nav>

    <div class="header-actions">
      <a class="cart-button" href="{{ routes.cart_url }}" aria-label="Cart with {{ cart.item_count }} items">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M6.5 7.5h11l-1 12h-9l-1-12ZM9 7.5a3 3 0 0 1 6 0" />
        </svg>
        <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
    <a href="{{ routes.root_url }}#products">Shop</a>
    <a href="{{ routes.root_url }}#story">Our Story</a>
    <a href="{{ routes.root_url }}#why-magnesium">Why Magnesium</a>
    <a href="{{ routes.root_url }}#faq">FAQ</a>
    <a href="{{ routes.root_url }}#contact">Contact</a>
  </nav>
</header>

{% schema %}
{
  "name": "Mineral Mist header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "100% Pure Magnesium from the Dead Sea"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Mineral Mist"
    },
    {
      "type": "text",
      "id": "logo",
      "label": "Logo asset filename",
      "default": "mineral-mist-logo-light.jpg"
    }
  ]
}
{% endschema %}
