    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Spray" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Apply according to the directions on your specific Mineral Mist product." }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "100% Pure Magnesium" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is Mineral Mist?" },
